<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS entitlements (DEFERRED — applied on the Mac Mini build).
     The spawned Python sidecar uses Bluetooth via the SDK; the hardened
     runtime needs the Bluetooth entitlement plus the ability to run the
     unsigned-at-build frozen binary. Notarization is required so Gatekeeper
     does not block the BLE-using child. See docs/BUILD.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.device.bluetooth</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
